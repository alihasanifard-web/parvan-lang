متغیر پنجره = ساخت_پنجره("سامانه یکپارچه پروان", 750, 480);

افزودن_متن(پنجره, "به سامانه حسابداری و هوشمند پروان خوش آمدید");
افزودن_ورودی(پنجره, "نام کاربری را وارد نمایید...");
افزودن_دکمه(پنجره, "ورود به حساب کاربری", تابع() {
    چاپ("دکمه ورود فشرده شد!");
});

افزودن_دکمه(پنجره, "خروج از سامانه", تابع() {
    چاپ("خروج انتخاب شد.");
});

چاپ("پنجره گرافیکی با موفقیت تنظیم شد.");
نمایش_پنجره(پنجره, درست); // حالت headless برای اجرای سریع و بدون وقفه
