// High-order functions and Closures in ParvanLang

fn make_adder(x) {
    return fn(y) {
        return x + y;
    };
}

let add5 = make_adder(5);
let add100 = make_adder(100);

print("5 + 20 =", add5(20));
print("100 + 45 =", add100(45));

// Map function implementation
fn map(arr, f) {
    let result = [];
    for item in arr {
        push(result, f(item));
    }
    return result;
}

let numbers = [1, 2, 3, 4, 5];
let squared = map(numbers, fn(n) { return n * n; });

print("Original array:", numbers);
print("Squared array:", squared);
