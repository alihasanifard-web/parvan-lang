// قابلیت نگارش به زبان شیرین فارسی در پروان
// ParvanLang Native Persian Syntax Demo

متغیر پیام = "درود بر تیم پروان!";
ثابت ضریب = 10;

چاپ(پیام);
چاپ("ضریب سیستم برابر است با:", ضریب);

تابع جمع_اعداد(الف, ب) {
    بازگردان الف + ب;
}

متغیر حاصل = جمع_اعداد(25, 75);
چاپ("حاصل جمع ۲۵ و ۷۵ در پروان:", حاصل);

اگر حاصل == 100 {
    چاپ("✓ اعتبارسنجی منطق شرطی با موفقیت انجام شد.");
} وگرنه {
    چاپ("خطا در محاسبات.");
}

چاپ("شمارش تا ۵ با حلقه فارسی:");
برای عدد در بازه(1, 6) {
    چاپ("-> شماره:", عدد);
}
