// 🧪 PARVAN IN-LANGUAGE UNIT TEST SUITE (مجموعه آزمون‌های درون‌زبانی پروان)
// معماران: علی حسنی‌فرد، احسان فضلی‌نژاد، امیرمهدی شهبازی
// ==============================================================================

تست("بررسی صحت محاسبات پایه و ریاضی", تابع() {
    متغیر جمع = 10 + 20;
    اطمینان(جمع == 30, "جمع ۱۰ و ۲۰ باید ۳۰ باشد");
    اطمینان(جذر(16) == 4, "جذر ۱۶ باید ۴ باشد");
});

تست("بررسی رفتارهای رشته و الحاق متن فارسی", تابع() {
    متغیر نام = "پروان";
    متغیر پیام = "سلام به " + نام;
    اطمینان(شامل_است(پیام, "پروان"), "پیام باید شامل نام پروان باشد");
});

تست("بررسی ساختار نگاشت و مقادیر کلیدها", تابع() {
    متغیر پاسخ = {"وضعیت": 200, "پیام": "موفق"};
    اطمینان(پاسخ["وضعیت"] == 200, "کد وضعیت باید ۲۰۰ باشد");
    اطمینان(پاسخ["پیام"] == "موفق", "پیام باید موفق باشد");
});
