// 🌐 PARVAN NATIVE WEB SERVER & REST API DEMO (دموی وب‌سرور چندترده بومی پروان)
// معماران: علی حسنی‌فرد، احسان فضلی‌نژاد، امیرمهدی شهبازی
// ==============================================================================

متغیر سرور = ساخت_وب_سرور();

// ثبت مسیر API با خروجی JSON خودکار
ثبت_مسیر(سرور, "GET", "/api/status", تابع(درخواست) {
    بازگردان {
        "وضعیت": "فعال",
        "نسخه": "4.0.0",
        "پیام": "درود از وب‌سرور بومی پروان!",
        "آدرس_درخواستی": درخواست.مسیر
    };
});

// ثبت مسیر متنی خوش‌آمدگویی
ثبت_مسیر(سرور, "GET", "/", تابع(درخواست) {
    بازگردان "<h1>به وب‌سرور زبان برنامه‌نویسی پروان خوش آمدید</h1>";
});

// ثبت مسیر اکوی داده با متد POST
ثبت_مسیر(سرور, "POST", "/api/echo", تابع(درخواست) {
    بازگردان {
        "متد": درخواست.متد,
        "داده_ارسال_شده": درخواست.بدنه,
        "موفق": درست
    };
});

چاپ("وب‌سرور پروان آماده دریافت درخواست‌ها است.");
// اجرای سرور (در صورت پاس دادن 'درست' به عنوان آرگومان سوم در پس‌زمینه اجرا می‌شود)
اجرای_وب_سرور(سرور, 8080, نادرست);
