{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Parvan",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.parvan",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.parvan",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.parvan",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.parvan",
          "match": "\\b(if|else|while|for|in|return|break|continue|switch|case|default|try|catch|import|as|async|await|enum|match|اگر|وگرنه|تا_زمانی_که|حلقه|برای|در|بازگردان|شکست|ادامه|انتخاب|حالت|پیش‌فرض|پیش_فرض|تلاش|خطا|وارد_کن|به_عنوان|ناهمگام|صبر|منتظر|شمارش|تطبیق)\\b"
        },
        {
          "name": "storage.type.parvan",
          "match": "\\b(let|const|fn|func|struct|class|متغیر|بگذار|ثابت|تابع|ساختار|کلاس)\\b"
        },
        {
          "name": "constant.language.parvan",
          "match": "\\b(true|false|nil|null|درست|غلط|هیچ)\\b"
        },
        {
          "name": "support.function.builtin.parvan",
          "match": "\\b(print|چاپ|println|چاپ_سطر|len|طول|push|افزودن|pop|حذف_آخر|range|بازه|keys|کلیدها|values|مقادیر|contains|شامل_است|reverse|معکوس|sort|مرتب_سازی|replace|جایگزینی|split|تفکیک|join|پیوستن|trim|پیرایش|input|ورودی|time|زمان|now|اکنون|to_jalali|به_شمسی|read_file|خواندن_فایل|write_file|نوشتن_فایل|remove_file|حذف_فایل|mkdir|ساخت_پوشه|list_dir|فهرست_پوشه|file_exists|وجود_فایل|http_get|دریافت_وب|http_post|ارسال_وب|http_put|ویرایش_وب|http_delete|حذف_وب|http_server_new|ساخت_وب_سرور|http_server_route|ثبت_مسیر|http_server_listen|اجرای_وب_سرور|http_server_stop|توقف_وب_سرور|http_response|پاسخ_وب|gc_collect|پاکسازی_حافظه|gc_stats|آمار_حافظه|channel_create|ساخت_کانال|channel_send|ارسال_کانال|channel_recv|دریافت_کانال|regex_match|تطبیق_الگو|regex_replace|جایگزینی_الگو|cache_set|تنظیم_حافظه|cache_get|دریافت_حافظه|db_open|پایگاه_داده|db_exec|اجرای_دیتابیس|db_query|پرسش_دیتابیس|db_begin|شروع_تراکنش|db_commit|تایید_تراکنش|db_rollback|لغو_تراکنش|abs|قدر_مطلق|sqrt|جذر|round|گرد|random|تصادفی|sleep|صبر|json_parse|پارس_جیسون|json_stringify|متن_جیسون|exit|خروج|assert|اطمینان|test|تست)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.parvan",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.parvan",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_\u0600-\u06FF][a-zA-Z0-9_\u0600-\u06FF]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.parvan"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.parvan",
          "match": "(\\+|\\-|\\*|/|%|=|==|!=|<|<=|>|>=|&&|\\|\\||\\|>|->|\\+=|\\-=)"
        }
      ]
    }
  },
  "scopeName": "source.parvan"
}
